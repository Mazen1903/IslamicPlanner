{
  "expo": {
    "name": "Islamic Daily Planner",
    "slug": "islamic-planner-app",
    "scheme": "islamic-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E442B"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mm1903.islamicplannerapp",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Islamic Daily Planner needs your location to calculate accurate prayer times."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mm1903.islamicplannerapp",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to unlock your private Journal."
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "IslamicPlannerSmall",
              "displayName": "Prayer Times",
              "targetName": "IslamicPlannerSmall",
              "entryPoint": "./widgets/ios/SmallWidget.tsx",
              "supportedFamilies": [
                "systemSmall"
              ]
            },
            {
              "name": "IslamicPlannerMedium",
              "displayName": "Prayer and Tasks",
              "targetName": "IslamicPlannerMedium",
              "entryPoint": "./widgets/ios/MediumWidget.tsx",
              "supportedFamilies": [
                "systemMedium"
              ]
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/ComicSansMS.ttf",
            "./assets/fonts/ComicSansMS-Bold.ttf"
          ],
          "widgets": [
            {
              "name": "IslamicPlannerSmall",
              "label": "Islamic Planner (Small)",
              "minWidth": "120dp",
              "minHeight": "110dp",
              "description": "Current prayer and next prayer time.",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "IslamicPlannerMedium",
              "label": "Islamic Planner (Medium)",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "description": "Prayer schedule and upcoming tasks.",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withAndroidWorkManagerResolution.js",
      "./plugins/withAndroidReleaseShrink.js",
      "expo-sharing"
    ]
  }
}
