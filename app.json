{
  "expo": {
    "name": "islamic-planner-app",
    "slug": "islamic-planner-app",
    "scheme": "islamic-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mm1903.islamicplannerapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mm1903.islamicplannerapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      "expo-secure-store",
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID to unlock your private Journal."
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "IslamicPlannerSmall",
              "displayName": "Prayer Times",
              "targetName": "IslamicPlannerSmall",
              "entryPoint": "./widgets/ios/SmallWidget.tsx",
              "supportedFamilies": ["systemSmall"]
            },
            {
              "name": "IslamicPlannerMedium",
              "displayName": "Prayer and Tasks",
              "targetName": "IslamicPlannerMedium",
              "entryPoint": "./widgets/ios/MediumWidget.tsx",
              "supportedFamilies": ["systemMedium"]
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "IslamicPlannerSmall",
              "label": "Islamic Planner (Small)",
              "minWidth": "120dp",
              "minHeight": "110dp",
              "description": "Current prayer and next prayer time.",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "IslamicPlannerMedium",
              "label": "Islamic Planner (Medium)",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "description": "Prayer schedule and upcoming tasks.",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "./plugins/withAndroidWorkManagerResolution.js"
    ]
  }
}
